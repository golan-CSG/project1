generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  whatsapp  String?
  createdAt DateTime @default(now())
  listings  Listing[]
}

model Listing {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  category    String
  brand       String?
  condition   String
  location    String?
  imageUrl    String?
  images      String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}
