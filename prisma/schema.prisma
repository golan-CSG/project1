generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  password     String
  name         String
  whatsapp     String?
  avatar       String?
  isAdmin      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  listings     Listing[]
  wantedPosts  WantedPost[]
  favorites    Favorite[]
  questions    Question[]
  answers      Answer[]
  wantedResponses WantedResponse[]
}

model Question {
  id          String   @id @default(cuid())
  title       String
  body        String
  attachment  String?
  attachType  String?
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  answers     Answer[]
}

model Answer {
  id          String   @id @default(cuid())
  body        String
  attachment  String?
  attachType  String?
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Answer?  @relation("AnswerReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Answer[] @relation("AnswerReplies")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model WantedPost {
  id          String           @id @default(cuid())
  title       String
  description String
  category    String
  maxPrice    Float?
  location    String?
  phone       String?
  email       String?
  attachment  String?
  attachType  String?
  createdAt   DateTime         @default(now())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  responses   WantedResponse[]
}

model WantedResponse {
  id           String     @id @default(cuid())
  body         String
  attachment   String?
  attachType   String?
  createdAt    DateTime   @default(now())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  wantedPostId String
  wantedPost   WantedPost @relation(fields: [wantedPostId], references: [id], onDelete: Cascade)
}

model Listing {
  id          String     @id @default(cuid())
  title       String
  description String
  price       Float
  category    String
  brand       String?
  condition   String
  location    String?
  imageUrl    String?
  images      String?
  phone       String?
  email       String?
  sold        Boolean    @default(false)
  createdAt   DateTime   @default(now())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  favorites   Favorite[]
}
