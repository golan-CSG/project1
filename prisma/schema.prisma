generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  password     String
  name         String
  whatsapp     String?
  avatar       String?
  createdAt    DateTime     @default(now())
  listings     Listing[]
  wantedPosts  WantedPost[]
  favorites    Favorite[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model WantedPost {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  maxPrice    Float?
  location    String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Listing {
  id          String     @id @default(cuid())
  title       String
  description String
  price       Float
  category    String
  brand       String?
  condition   String
  location    String?
  imageUrl    String?
  images      String?
  phone       String?
  email       String?
  createdAt   DateTime   @default(now())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  favorites   Favorite[]
}
